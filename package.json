{
  "name": "gaga-livechat",
  "version": "1.0.0",
  "description": "Gaga Games livechat AI system",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "gateway:start": "tsx services/gateway/src/index.ts",
    "orchestrator:start": "tsx services/orchestrator/src/index.ts",
    "seed:agents": "tsx scripts/seed-agents.ts",
    "seed:kb": "tsx scripts/seed-kb.ts",
    "seed:guardrails": "tsx scripts/seed-guardrails.ts",
    "panel:dev": "vite apps/agent-panel --port 3002 --host 127.0.0.1",
    "panel:build": "vite build apps/agent-panel",
    "widget:build": "vite build --config apps/widget/vite.config.ts",
    "build:all": "npm run panel:build && npm run widget:build",
    "migrate:deploy": "tsx scripts/deploy-migrate.ts",
    "generate:logos": "tsx scripts/generate-logos.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:db": "node --test --import tsx test/db-migration.test.ts",
    "test:gateway": "node --test --test-timeout=10000 --import tsx services/gateway/test/gateway.test.ts",
    "test:widget": "node --test --test-timeout=15000 --import tsx apps/widget/test/widget.test.ts",
    "test:agent": "node --test --test-timeout=15000 --import tsx services/gateway/test/agent-panel.test.ts",
    "test:kb": "node --test --test-timeout=15000 --import tsx services/orchestrator/test/kb.test.ts",
    "test:orchestrator": "node --test --test-timeout=15000 --import tsx services/orchestrator/test/orchestrator.test.ts",
    "test:guardrails": "node --test --test-timeout=15000 --import tsx services/orchestrator/test/guardrails.test.ts",
    "test:shadow": "node --test --test-timeout=15000 --import tsx services/gateway/test/shadow-mode.test.ts",
    "test:studio": "node --test --test-timeout=15000 --import tsx services/gateway/test/studio.test.ts",
    "test:autoreply": "node --test --test-timeout=15000 --import tsx services/gateway/test/auto-reply.test.ts",
    "test:continuous": "node --test --test-timeout=20000 --import tsx services/orchestrator/test/continuous-conversation.test.ts",
    "test:proactive": "node --test --test-timeout=25000 --import tsx services/gateway/test/proactive-greeting.test.ts",
    "test:investigation": "node --test --test-timeout=20000 --import tsx services/gateway/test/investigation-checklist.test.ts",
    "test:attachment": "node --test --test-timeout=20000 --import tsx services/gateway/test/attachment-evidence.test.ts",
    "test:auth": "node --test --test-timeout=25000 --import tsx services/gateway/test/auth-production.test.ts",
    "test": "node --test --test-timeout=15000 --test-concurrency=1 --import tsx services/gateway/test/gateway.test.ts apps/widget/test/widget.test.ts services/gateway/test/agent-panel.test.ts services/orchestrator/test/kb.test.ts services/orchestrator/test/orchestrator.test.ts services/orchestrator/test/guardrails.test.ts services/orchestrator/test/continuous-conversation.test.ts services/gateway/test/shadow-mode.test.ts services/gateway/test/studio.test.ts services/gateway/test/auto-reply.test.ts services/gateway/test/proactive-greeting.test.ts services/gateway/test/investigation-checklist.test.ts services/gateway/test/attachment-evidence.test.ts services/gateway/test/auth-production.test.ts test/db-migration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.5.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
