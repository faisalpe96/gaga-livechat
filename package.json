{
  "name": "gaga-livechat",
  "version": "1.0.0",
  "description": "Gaga Games livechat AI system",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "gateway:start": "tsx services/gateway/src/index.ts",
    "seed:agents": "tsx scripts/seed-agents.ts",
    "panel:dev": "vite apps/agent-panel --port 3002 --host 127.0.0.1",
    "test:db": "node --test --import tsx test/db-migration.test.ts",
    "test:gateway": "node --test --test-timeout=10000 --import tsx services/gateway/test/gateway.test.ts",
    "test:widget": "node --test --test-timeout=15000 --import tsx apps/widget/test/widget.test.ts",
    "test:agent": "node --test --test-timeout=15000 --import tsx services/gateway/test/agent-panel.test.ts",
    "test": "node --test --test-timeout=15000 --test-concurrency=1 --import tsx test/db-migration.test.ts services/gateway/test/gateway.test.ts apps/widget/test/widget.test.ts services/gateway/test/agent-panel.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "preact": "^10.29.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.5.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
