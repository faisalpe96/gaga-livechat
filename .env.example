# =============================================================================
# GAGA GAMES LIVECHAT — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sesuai dengan spesifikasi arsitektur & keamanan spec/09-produksi.md
# =============================================================================
# PERINGATAN KEAMANAN:
# JANGAN PERNAH mengisi nilai rahasia produksi langsung ke dalam berkas ini.
# Salin berkas ini ke '.env' untuk pengembangan lokal, atau masukkan variabel
# langsung ke secret manager platform cloud (Railway, Supabase, Cloudflare).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
# Gateway server port (default: 3001)
PORT=3001
GATEWAY_PORT=3001
# Orchestrator server port (default: 3003)
ORCHESTRATOR_PORT=3003
# URL internal gateway untuk memanggil orchestrator (di Railway: gunakan private networking domain)
ORCHESTRATOR_URL=http://127.0.0.1:3003
# Wajibkan autentikasi session & cookie (true untuk produksi)
ENFORCE_AUTH=true
# Secret penandatangan cookie sesi. WAJIB di produksi, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=generate-a-strong-random-secret-at-least-32-chars-long

# -----------------------------------------------------------------------------
# 2. BASIS DATA (PostgreSQL 15+ dengan pgvector — Region Singapura)
# -----------------------------------------------------------------------------
# Contoh Supabase: postgres://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Mode Session / Direct: postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 3. REDIS PUB/SUB & FAN-OUT (Upstash / Redis Cloud — Region Singapura)
# -----------------------------------------------------------------------------
# Wajib TLS (rediss://) untuk serverless cloud Redis
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# -----------------------------------------------------------------------------
# 4. GAME BACKEND INTEGRATION & PLAYER TOKEN (spec/09-produksi.md Bagian 2)
# -----------------------------------------------------------------------------
# Base URL API game untuk memanggil tool verifikasi transaksi, status akun, dll.
GAME_API_BASE_URL=https://api.gagagames.example
# Service token berotasi untuk autentikasi antar-layanan (mTLS / bearer)
GAME_API_SERVICE_TOKEN=your-game-service-token-secret
# URL JWKS game backend untuk verifikasi JWT pemain berumur pendek tanpa deploy ulang
GAME_JWKS_URL=https://api.gagagames.example/.well-known/jwks.json

# -----------------------------------------------------------------------------
# 5. MODEL BAHASA & EMBEDDING (LLM Engine)
# -----------------------------------------------------------------------------
# Provider LLM: 'mock' (default, tanpa jaringan/biaya) atau 'anthropic'
LLM_PROVIDER=mock
# Wajib jika LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model Claude (default: claude-opus-5). Alternatif lebih murah: claude-sonnet-5
LLM_MODEL=claude-opus-5
# Tingkat usaha model: low | medium (default) | high | xhigh | max
LLM_EFFORT=medium
# Batas waktu satu permintaan ke API dalam milidetik (default 20000)
LLM_TIMEOUT_MS=20000
# Embedding teks (dimension 1536): 'true' memakai OpenAI text-embedding-3-small dengan OPENAI_API_KEY
USE_REAL_EMBEDDINGS=false
OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# 6. OBJECT STORAGE UNTUK LAMPIRAN (S3 / Cloudflare R2 / Supabase Storage)
# -----------------------------------------------------------------------------
# Provider: 'local', 'supabase', 's3', atau 'r2'
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=livechat-attachments
# Kunci akses S3 API kompatibel
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
# Endpoint S3-compatible (misal: https://[project-ref].supabase.co/storage/v1/s3 atau Cloudflare R2)
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-1
# Kunci rahasia HMAC untuk menandatangani Signed URL berbatas waktu lampiran
# WAJIB di produksi, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATTACHMENT_SIGNING_SECRET=generate-a-strong-random-secret-at-least-32-chars-long

# -----------------------------------------------------------------------------
# 7. SINGLE SIGN-ON (OIDC) — Google Workspace / Microsoft Entra ID
# -----------------------------------------------------------------------------
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# 8. KEAMANAN CORS & EMBED WIDGET
# -----------------------------------------------------------------------------
# Domain resmi game Gaga Games yang diizinkan memuat dan meng-embed widget chat
ALLOWED_WIDGET_ORIGINS=https://game.gagagames.com,https://pay.gagagames.com,https://account.gagagames.com

# -----------------------------------------------------------------------------
# 9. FRONTEND STATIC BUILD (Vite)
# -----------------------------------------------------------------------------
# Digunakan saat mem-build panel agent statis untuk diarahkan ke backend gateway Railway
VITE_GATEWAY_URL=https://gateway.livechat.gagagames.com
